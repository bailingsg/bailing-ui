# Bailing Wooden Web - 环境变量模板
# 复制为 .env 后按需修改；.env 不得提交 Git。
# Next.js 会自动加载 .env。

# 后端 API 基础地址（本地开发默认值）
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# 站点名称（展示用）
NEXT_PUBLIC_SITE_NAME=Bailing Wooden

# ---------- 生产环境占位符（部署时填写） ----------
# NEXT_PUBLIC_API_BASE_URL=https://api.bailingwooden.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://bailingwooden.com
# 注意：任何 NEXT_PUBLIC_ 变量都会暴露到浏览器，禁止放置数据库密码、
# 邮箱密码、腾讯云 COS SecretId/SecretKey 等敏感信息。
