# Bailing Wooden Web - 环境变量模板
# 复制为 .env 后按需修改；.env 不得提交 Git。
# Next.js 会自动加载 .env。

# 后端 API 基础地址（本地开发默认值）
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1

# 站点名称（展示用）
NEXT_PUBLIC_SITE_NAME=Bailing Wooden

# ---------- CMS 数据源总开关（Phase 4.7） ----------
# demo：使用仓库内置的演示数据 / 版式（离线、可静态构建，当前默认）
# api ：调用 bailing-backend 公开只读接口（/api/v1/public/* 与 /api/v1/products）
# 未设置时默认 demo。
#
# 控制范围（统一开关）：
#   · 站点内容分区：首页 / 关于我们（SiteSection：home.* / hero、profile、story…）
#   · 导航：页眉 / 页脚（NavItem，仅 isActive=true）
#   · 博客：列表 / 详情 / 分类（仅 PUBLISHED）
#   · 工厂实力：分区正文与图库 / 展会照片
#   · 质量体系：已发布的认证与检测报告（仅 PUBLISHED）
#   · 产品应用场景：已发布场景与关联产品（仅 PUBLISHED）
#   · 产品目录（/api/v1/products）
#
# api 模式下后端不可用会如实报错（由 error 边界接管），**不会**静默回退
# 演示数据——避免把占位内容当成真实内容展示给访客。
NEXT_PUBLIC_CMS_SOURCE=demo

# 产品数据源（Phase 3.5，向后兼容开关；与 NEXT_PUBLIC_CMS_SOURCE 任一为
# api 即走接口）。新部署建议只使用 NEXT_PUBLIC_CMS_SOURCE。
NEXT_PUBLIC_PRODUCTS_SOURCE=demo

# ---------- 生产环境占位符（部署时填写） ----------
# NEXT_PUBLIC_API_BASE_URL=https://api.bailingwooden.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://bailingwooden.com
# NEXT_PUBLIC_CMS_SOURCE=api
# NEXT_PUBLIC_PRODUCTS_SOURCE=api
# 注意：任何 NEXT_PUBLIC_ 变量都会暴露到浏览器，禁止放置数据库密码、
# 邮箱密码、腾讯云 COS SecretId/SecretKey 等敏感信息。
